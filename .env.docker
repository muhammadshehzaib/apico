# Copy this file to .env before running docker compose:
#   cp .env.docker .env
# then edit the values below.

# ---- REQUIRED: change these before deploying ----
# Generate strong secrets, e.g.:  openssl rand -base64 48
JWT_SECRET=change-me-min-32-characters-long-secret
JWT_REFRESH_SECRET=change-me-min-32-characters-refresh-secret

# Strong database passwords
MYSQL_ROOT_PASSWORD=change-me-strong-root-password
MYSQL_PASSWORD=change-me-strong-apico-password

# ---- Public URLs (set these to your domain in production) ----
# The browser bundle calls the API at this EXACT url (baked in at build time,
# so you must rebuild the web image if you change it). Include the /api/v1 path.
NEXT_PUBLIC_API_URL=https://apico.yourdomain.com/api/v1
# Allowed CORS origin = where the web app is served from (no trailing slash).
CORS_ORIGIN=https://apico.yourdomain.com
# Used in workspace-invite email links.
WEB_APP_URL=https://apico.yourdomain.com

# ---- Host ports (bound to 127.0.0.1; your reverse proxy forwards to these) ----
# Change if these clash with something already running on the VPS.
WEB_PORT=3000
API_PORT=5000

# ---- Token lifetimes ----
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

LOG_LEVEL=info

# ---- Optional: SMTP for workspace-invite emails (leave blank to disable) ----
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=Apico <no-reply@yourdomain.com>
